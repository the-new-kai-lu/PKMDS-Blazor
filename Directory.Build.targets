<Project>
    <PropertyGroup>
        <!-- This fork consumes its sibling fork, never the retail NuGet package. -->
        <PKHeXSourcePath Condition="'$(PKHeXSourcePath)' == ''">$(MSBuildThisFileDirectory)../PKHeX/PKHeX.Core/PKHeX.Core.csproj</PKHeXSourcePath>
    </PropertyGroup>
    <ItemGroup>
        <!-- Item expressions must be evaluated in an ItemGroup, not a property. -->
        <_LocalPKHeX Include="@(PackageReference->WithMetadataValue('Identity', 'PKHeX.Core'))" />
        <PackageReference Remove="@(_LocalPKHeX)" />
        <ProjectReference Include="$(PKHeXSourcePath)" Condition="'@(_LocalPKHeX)' != ''" />
    </ItemGroup>
    <Target Name="RequireHGEngineCore" BeforeTargets="Restore;PrepareForBuild" Condition="'@(_LocalPKHeX)' != ''">
        <Error Condition="!Exists('$(PKHeXSourcePath)')" Text="Clone the-new-kai-lu/PKHeX next to this repository, or set PKHeXSourcePath to its PKHeX.Core.csproj." />
    </Target>
</Project>
